{
    "name": "mattsplat/declarative-pdf",
    "description": "A typed, declarative PDF generation library with a block-layout engine.",
    "type": "library",
    "keywords": ["pdf", "pdf-generation", "fpdf", "layout", "typesetting", "acroform", "pdf-forms"],
    "homepage": "https://github.com/mattsplat/declarative-pdf",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Coleman",
            "email": "matthewjohncoleman@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mattsplat/declarative-pdf/issues",
        "source": "https://github.com/mattsplat/declarative-pdf"
    },
    "require": {
        "php": ">=8.3",
        "ext-zlib": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-gd": "Needed to decode GIF and WebP images",
        "ext-iconv": "Faster text encoding conversion",
        "ext-curl": "Fallback for fetching image URLs when allow_url_fopen is disabled"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pdf\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "check": [
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "stan": "Run PHPStan static analysis (level 6)",
        "check": "Run static analysis and the test suite"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.3.x-dev"
        }
    }
}
