# Keep the Composer package lean: these are not needed to use the library.
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.github            export-ignore
/CLAUDE.md          export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/docs               export-ignore
/examples           export-ignore
/tests              export-ignore
# tools/makefont/ is NOT export-ignored: it is how users build embedded-font
# definitions from a .ttf/.otf, and the docs reference it.

# Binary reference data — never diff or merge these.
*.pdf   binary
*.z     binary
*.otf   binary
*.ttf   binary
*.png   binary
*.jpg   binary
*.gif   binary
