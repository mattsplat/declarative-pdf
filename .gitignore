# --- Dependencies -----------------------------------------------------------
/vendor/

# composer.lock is intentionally not committed: this is a library, not an app.
/composer.lock

# --- Tool caches -----------------------------------------------------------
/.phpunit.cache/
/.phpunit.result.cache
/.phpstan.cache/
/.phpstan/
/.php-cs-fixer.cache
/.php-cs-fixer.php.cache
/.psalm/
/.rector.cache/

# --- Test / analysis output ----------------------------------------------
/build/
/coverage/
/.phpunit.coverage/
/clover.xml
/coverage.xml
/junit.xml
/.phpunit-watcher.yml

# --- Generated artifacts -------------------------------------------------
# Example scripts write their PDFs next to themselves.
/examples/*.pdf
# tests/golden/*.pdf and tests/fixtures/* ARE committed (reference data).

# --- Local overrides ---------------------------------------------------
/phpunit.xml.dist.local
/phpstan.neon.local
/.env
/.env.local

# Claude Code: share CLAUDE.md, .claude/settings.json and .claude/agents/;
# keep each developer's personal settings and scratch worktrees local.
/.claude/settings.local.json
/.claude/worktrees/

# --- Editors / IDEs --------------------------------------------------
/.idea/
/.vscode/
/.fleet/
/.zed/
/nbproject/
*.iml
*.sublime-project
*.sublime-workspace
.phpactor.json

